{
  "name": "careerpilot-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @piaa/web run dev",
    "build:web": "npm --workspace @piaa/web run build",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace @piaa/web run lint",
    "typecheck:web": "npm --workspace @piaa/web run typecheck",
    "dev:api": "npm --workspace api run start:dev",
    "build:api": "npm --workspace api run build",
    "start:api": "npm --workspace api run start:prod",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "npm run typecheck:web",
    "validate:companies": "node --experimental-strip-types scripts/validate-company-catalog.mjs",
    "validate:companies:metadata": "node --experimental-strip-types scripts/validate-company-catalog.mjs --metadata-only",
    "jobs:backfill-identities": "node scripts/backfill-job-identities.mjs",
    "db:init": "node --experimental-strip-types infra/init-db.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "dependencies": {
    "string-similarity": "^4.0.4"
  }
}
