# ==============================================================================
# CareerPilot AI — Production Environment Configuration
# ==============================================================================

# Supabase (Auth, Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PRIVATE_SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-region.pooler.supabase.com:5432/postgres

# CareerPilot Core API
CAREERPILOT_API_URL=https://your-api-domain.com/api
INTERNAL_API_KEY=your-secure-internal-api-key
PORT=4000

# LLM Providers (Groq & Gemini)
GROQ_API_KEY=gsk_your_groq_api_key_1
GROQ_API_KEY_2=gsk_your_groq_api_key_2
GROQ_API_KEY_3=gsk_your_groq_api_key_3
GROQ_API_KEY_4=gsk_your_groq_api_key_4
GEMINI_API_KEY=your_gemini_api_key

# Web Scraping & Crawling
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
